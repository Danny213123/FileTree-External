**/target/
/dist-portable
/dist-demo
/frontend/dist-demo/
__pycache__/
/*.exe
/*.log
*.pdb

# Claude AI planning artifacts
/.claude/
/.planning/

# Generated planning / spec artifacts (GSD-style; regenerated on demand, not part
# of the product). The directories above already cover copies kept under them;
# the rules below catch the loose copies that land at the repo root. Real docs
# (README.md, CHANGELOG.md, LICENSE*, CONTRIBUTING.md) are intentionally NOT listed.
/AI-SPEC.md
/SPEC.md
/PLAN.md
/RESEARCH.md
/REVIEW.md
/EVAL-REVIEW.md
/UI-SPEC.md
/UI-REVIEW.md
/SECURITY.md
/VERIFICATION.md
/PATTERNS.md
/INGEST-*.md

# Frontend build artifacts (the bundle is generated by `npm run build`)
/frontend/dist/
/frontend/node_modules/
/node_modules/
/frontend/frontend/
/artifacts/
/src-tauri/gen/

# Local dev helper
run.bat

# Local media / screenshots
/images/
/.verify_*.png

# --- Build outputs / stray files (not needed to build or run) ---
# Packaged desktop app (regenerate via build-portable.bat)
/dist-electron/
# Logs anywhere (e.g. .cursor/debug-*.log)
*.log
# Stray downloads / data exports accidentally dropped in the tree
*.zip
*.csv
/electron/taglinter.yml

# Tauri installers are release artifacts, not source.
/target/release/bundle/
